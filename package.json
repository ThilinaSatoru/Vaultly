{
  "name": "vaultly",
  "version": "0.3.5",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @vaultly/api dev\" \"pnpm --filter @vaultly/web dev\"",
    "desktop:dev": "pnpm --filter @vaultly/desktop dev",
    "desktop:build": "pnpm --filter @vaultly/web build && pnpm --filter @vaultly/desktop build",
    "desktop:dist": "pnpm --filter @vaultly/desktop dist",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test && node --test scripts/*.test.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:notes": "node scripts/release.mjs notes"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
